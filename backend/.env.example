# MySQL/MariaDB (cPanel HostGator) connection string — driver PyMySQL, porta padrão 3306.
# Também aceita sqlite:///./dev.db (dev local sem MySQL) ou, durante a transição, ainda
# postgresql+psycopg2://... (Supabase legado — ver instrucoes-migracao-postgres-mysql.md).
DATABASE_URL=mysql+pymysql://usuario_cpanel:senha@localhost:3306/usuario_cpanel_nomedobanco

# Usada só pelo script de migração de dados (Postgres -> MySQL) enquanto DATABASE_URL ainda
# aponta pro Postgres antigo. Depois da migração validada, DATABASE_URL passa a ser o MySQL
# e essa variável pode ser removida.
# MYSQL_DATABASE_URL=mysql+pymysql://usuario_cpanel:senha@localhost:3306/usuario_cpanel_nomedobanco

# Segredo usado para assinar os JWT. Gere um valor aleatório forte em produção.
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-forte
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Origens do frontend liberadas no CORS (sem barra final; separadas por vírgula se houver mais de uma).
FRONTEND_ORIGIN=http://localhost:5174