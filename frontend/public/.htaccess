
# SPA fallback: qualquer rota que não seja um arquivo/pasta real cai em index.html (React Router
# cuida do resto no client-side). Equivalente ao rewrite do vercel.json.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# sw.js e manifest.json nunca devem ficar em cache do navegador (senão o PWA não pega
# atualização nova) — mesmo comportamento configurado no vercel.json.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
