# Postgres (Supabase) connection string. Também aceita sqlite:///./dev.db para rodar local sem Postgres.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Segredo usado para assinar os JWT. Gere um valor aleatório forte em produção.
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-forte
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Origem exata do frontend (sem barra final) liberada no CORS.
FRONTEND_ORIGIN=http://localhost:5174

# Senha padrão usada pelo script de seed para os 3 usuários sócios (pode trocar depois do primeiro login).
SEED_DEFAULT_PASSWORD=troque-no-primeiro-acesso
